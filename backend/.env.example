OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DATABASE_URL=postgresql://diettracker:diettracker_local@localhost:5432/diettracker
# Optional initial timezone; the GUI setting is persisted in the database.
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_USERNAME=
APP_PASSWORD_HASH=
APP_SESSION_SECRET=
# Comma-separated when local and deployed frontends both need access.
FRONTEND_URLS=http://localhost:5173
# Set true on Railway so the cross-site session cookie is HTTPS-only.
COOKIE_SECURE=false
